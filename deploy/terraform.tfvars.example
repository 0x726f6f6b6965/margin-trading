aws_region         = "ap-northeast-1"
function_name      = "margin-trading-bot"
architecture       = "arm64"
timeout            = 300
memory_size        = 128
chat_room          = "-1004224867347"
telegram_bot_token = "YOUR_TELEGRAM_BOT_TOKEN"
tfp                = "35000"

# 週一至週五 13:30 UTC+8 (即 UTC 05:30) 自動觸發
schedule_expression = "cron(30 5 ? * MON-FRI *)"

